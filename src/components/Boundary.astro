---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const isZh = lang === 'zh';

const githubAuthority = isZh
  ? [
      '分支保护规则与 Rulesets（事实来源）',
      '评审指派与审批决策',
      'Actions、Checks 与环境保护',
      '可合并性与合并方式',
      '仓库与 GitHub App 安装范围',
      '生产合并与回滚的最终决策',
    ]
  : [
      'Branch protection rulesets (source of truth)',
      'Reviewer assignment and approval decisions',
      'Actions, Checks, and Environment protection',
      'Mergeability and merge method',
      'Repository and GitHub App installation scope',
      'Final decision on production merge and rollback',
    ];

const prHelperResponsible = isZh
  ? [
      '跨仓库的 Lane 状态编排与推进',
      '从 GitHub 事实评估闸门决策',
      '实时 Webhook 摄入与定时对账',
      '关闭标签页的 Web Push 送达',
      'AI 生成的 PR 草稿（密钥仅会话）',
      '部署追踪、健康检查与审计事件',
      '仅在用户明确确认后调度回滚',
    ]
  : [
      'Cross-repo Lane state orchestration and advance',
      'Gate decisions evaluated from GitHub facts',
      'Real-time Webhook ingestion and scheduled reconciliation',
      'Closed-tab Web Push delivery',
      'AI-generated PR drafts (session-only keys)',
      'Deployment tracking, health checks, and audit events',
      'Rollback dispatch only after explicit user confirmation',
    ];
---

<section id="boundary" class="border-t border-ink-800/60 bg-ink-900/30 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('boundary.title')}</h2>
      <p class="mt-3 text-ink-400">{t('boundary.subtitle')}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div class="rounded-xl border border-ink-800 bg-ink-900/60 p-6">
        <h3 class="text-base font-semibold text-ink-50">
          {isZh ? 'GitHub 权威' : 'GitHub authority'}
        </h3>
        <ul class="mt-4 space-y-2">
          {githubAuthority.map((item) => (
            <li class="flex items-start gap-2 text-sm text-ink-300">
              <span class="mt-1 text-brand-400">→</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-xl border border-brand-500/30 bg-brand-500/5 p-6">
        <h3 class="text-base font-semibold text-brand-200">
          {isZh ? 'PR Helper 负责' : 'PR Helper is responsible for'}
        </h3>
        <ul class="mt-4 space-y-2">
          {prHelperResponsible.map((item) => (
            <li class="flex items-start gap-2 text-sm text-ink-200">
              <span class="mt-1 text-brand-400">→</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-ink-500">
      {isZh
        ? 'PR Helper 可以保证流程与证据完整，不能替代 GitHub 的分支保护与人工审批。'
        : 'PR Helper guarantees process and evidence integrity, not a replacement for GitHub branch protection or human approval.'}
    </p>
  </div>
</section>
