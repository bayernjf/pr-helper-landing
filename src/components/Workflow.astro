---
import { useTranslations, type Lang } from '../i18n';
import { workflowSteps } from '../data/workflow';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const steps = workflowSteps[lang];
---

<section id="workflow" aria-label={t('path.title')} class="border-t border-ink-800/60 bg-ink-950 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('path.title')}</h2>
      <p class="mt-3 text-ink-400">{t('path.subtitle')}</p>
    </div>

    <ol class="mt-12 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3">
      {steps.map((step, i) => (
        <li class="group relative rounded-lg border border-ink-800 bg-ink-900/50 p-4 transition hover:border-brand-500/40">
          <div class="flex items-center gap-2">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-ink-800 font-mono text-xs text-brand-300" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-sm font-medium text-ink-100">{step.label}</span>
          </div>
          <p class="mt-2 text-xs leading-relaxed text-ink-400">{step.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
