---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import { useTranslations, localizePath, type Lang } from '../i18n';
import { SITE_NAME, SOCIAL } from '../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const links = [
  { href: localizePath('/blog', lang), label: t('nav.blog') },
  { href: SOCIAL.docs, label: t('nav.docs'), external: true },
  { href: SOCIAL.github, label: 'GitHub', external: true },
  { href: 'https://bayjf.com', label: 'BayJF', external: true },
  { href: localizePath('/privacy', lang), label: lang === 'zh' ? '隐私政策' : 'Privacy' },
  { href: localizePath('/terms', lang), label: lang === 'zh' ? '服务条款' : 'Terms' },
];
---

<footer class="border-t border-ink-800/60 bg-ink-950">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 32 32" class="h-6 w-6" aria-hidden="true">
          <defs>
            <linearGradient id="phFtBg" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#2b1a4d" />
              <stop offset="100%" stop-color="#0d0a1a" />
            </linearGradient>
            <linearGradient id="phFtInk" x1="8" y1="8" x2="24" y2="26" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#f472b6" />
              <stop offset="50%" stop-color="#a78bfa" />
              <stop offset="100%" stop-color="#38bdf8" />
            </linearGradient>
          </defs>
          <rect width="32" height="32" rx="7" fill="url(#phFtBg)" />
          <path d="M8 10 L8 14 L14 18 L14 22" fill="none" stroke="url(#phFtInk)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="8" cy="10" r="2.2" fill="url(#phFtInk)" />
          <path d="M24 10 L24 14 L18 18 L18 22" fill="none" stroke="url(#phFtInk)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="24" cy="10" r="2.2" fill="url(#phFtInk)" />
          <path d="M14 22 L16 24 L18 22" fill="none" stroke="url(#phFtInk)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="16" cy="24" r="2.2" fill="url(#phFtInk)" />
        </svg>
        <div>
          <p class="text-sm font-medium text-ink-100">{SITE_NAME}</p>
          <p class="text-xs text-ink-500">{t('footer.tagline')}</p>
        </div>
      </div>

      <nav class="flex flex-wrap items-center justify-center gap-5">
        {links.map((l) => (
          l.href === 'https://bayjf.com' ? (
            <BayjfLink
              size={16}
              class="text-xs text-ink-400 transition hover:text-ink-100"
              label={l.label}
            />
          ) : (
            <a
              href={l.href}
              class="text-xs text-ink-400 transition hover:text-ink-100"
            >
              {l.label}
            </a>
          )
        ))}
      </nav>
    </div>

    <div class="mt-8 border-t border-ink-800/50 pt-6 text-center">
      <p class="text-xs text-ink-500">
        © {year} {SITE_NAME}. {t('footer.rights')}
      </p>
    </div>
  </div>
</footer>
