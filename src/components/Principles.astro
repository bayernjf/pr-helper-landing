---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const isZh = lang === 'zh';

const principles = isZh
  ? [
      {
        title: 'GitHub 是权威',
        desc: 'GitHub 始终是分支保护、评审、检查、可合并性、Actions 与环境保护的权威。永远不在 UI 状态中绕过 GitHub 的拒绝。',
      },
      {
        title: '显式生产操作',
        desc: '生产合并与回滚都是显式用户操作。无单独获批的产品与安全设计前，不添加自动生产合并或回滚。',
      },
      {
        title: '外部事实高于自述',
        desc: '闸门决策基于真实的 GitHub Checks、Reviews、Mergeability、部署记录与健康检查，而非 Agent 或 UI 的自然语言总结。',
      },
      {
        title: '实时 + 对账',
        desc: 'Webhook 提供实时速度，定时对账保证正确性。两者并存，缺一不可。',
      },
      {
        title: '凭据不落浏览器',
        desc: 'GitHub App 密钥与安装令牌保留在服务端模块 api/_lib/ 下。AI 密钥仅会话级，未设计加密前不持久化。',
      },
      {
        title: '迁移即事实',
        desc: '数据库变更只能新增有序迁移文件，不在运行时执行 DDL，不编辑已应用的迁移。',
      },
    ]
  : [
      {
        title: 'GitHub is the authority',
        desc: 'GitHub remains the authority for branch protection, reviews, checks, mergeability, Actions, and Environment protection. Never bypass a GitHub rejection in UI state.',
      },
      {
        title: 'Explicit production actions',
        desc: 'Production merge and rollback are explicit user actions. No automatic production merge or rollback is added without a separately approved product and safety design.',
      },
      {
        title: 'External facts over self-report',
        desc: 'Gate decisions are grounded in real GitHub Checks, Reviews, Mergeability, deployment records, and health checks — not Agent or UI natural-language summaries.',
      },
      {
        title: 'Real-time + reconciliation',
        desc: 'Webhooks provide real-time speed; scheduled reconciliation guarantees correctness. Both coexist; neither alone is sufficient.',
      },
      {
        title: 'Credentials never reach the browser',
        desc: 'GitHub App secrets and installation tokens stay behind server modules under api/_lib/. AI keys are session-only and not persisted before encryption is designed.',
      },
      {
        title: 'Migrations are the truth',
        desc: 'Database changes go only in new ordered migration files. No runtime DDL, and never edit an already-applied migration.',
      },
    ];
---

<section id="principles" class="border-t border-ink-800/60 bg-ink-950 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('principles.title')}</h2>
      <p class="mt-3 text-ink-400">{t('principles.subtitle')}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {principles.map((p, i) => (
        <div class="rounded-xl border border-ink-800 bg-ink-900/50 p-6">
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-brand-400">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-base font-semibold text-ink-50">{p.title}</h3>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-ink-300">{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
