---
import { useTranslations, type Lang } from '../i18n';
import { faqData } from '../data/faq';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const items = faqData[lang];
---

<section id="faq" aria-label={t('faq.title')} class="border-t border-ink-800/60 bg-ink-900/30 py-20">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('faq.title')}</h2>
      <p class="mt-3 text-ink-400">{t('faq.subtitle')}</p>
    </div>

    <div class="mt-12 space-y-4">
      {items.map((item) => (
        <details class="group rounded-lg border border-ink-800 bg-ink-900/60 p-5">
          <summary class="flex cursor-pointer items-center justify-between marker:content-none">
            <h3 class="text-sm font-medium text-ink-100">{item.question}</h3>
            <span class="ml-4 text-ink-500 transition group-open:rotate-180" aria-hidden="true">▾</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-ink-300">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
