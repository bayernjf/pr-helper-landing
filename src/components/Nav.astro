---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import StarOnGithub from '@bay/landing-ui/components/StarOnGithub.astro';
import { useTranslations, localizePath, getAltLangPath, type Lang } from '../i18n';
import { SITE_NAME, SOCIAL, APP_URL } from '../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { href: localizePath('/#workflow', lang), label: t('nav.workflow') },
  { href: localizePath('/#features', lang), label: t('nav.features') },
  { href: localizePath('/#comparison', lang), label: t('nav.comparison') },
  { href: localizePath('/#principles', lang), label: t('nav.principles') },
  { href: localizePath('/#faq', lang), label: t('nav.faq') },
  { href: localizePath('/blog', lang), label: t('nav.blog') },
  { href: SOCIAL.docs, label: t('nav.docs'), external: true },
];

const altLang = lang === 'zh' ? 'en' : 'zh';
const altLangHref = getAltLangPath(Astro.url.pathname, altLang);
---

<header class="sticky top-0 z-50 border-b border-ink-800/60 bg-ink-950/80 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href={localizePath('/', lang)} class="flex items-center gap-2 text-base font-semibold text-ink-50">
      <svg viewBox="0 0 32 32" class="h-7 w-7" aria-hidden="true">
        <defs>
          <linearGradient id="phNavBg" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#2b1a4d" />
            <stop offset="100%" stop-color="#0d0a1a" />
          </linearGradient>
          <linearGradient id="phNavInk" x1="8" y1="8" x2="24" y2="26" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#f472b6" />
            <stop offset="50%" stop-color="#a78bfa" />
            <stop offset="100%" stop-color="#38bdf8" />
          </linearGradient>
        </defs>
        <rect width="32" height="32" rx="7" fill="url(#phNavBg)" />
        <path d="M8 10 L8 14 L14 18 L14 22" fill="none" stroke="url(#phNavInk)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="8" cy="10" r="2.2" fill="url(#phNavInk)" />
        <path d="M24 10 L24 14 L18 18 L18 22" fill="none" stroke="url(#phNavInk)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="24" cy="10" r="2.2" fill="url(#phNavInk)" />
        <path d="M14 22 L16 24 L18 22" fill="none" stroke="url(#phNavInk)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="16" cy="24" r="2.2" fill="url(#phNavInk)" />
      </svg>
      <span>{SITE_NAME}</span>
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm text-ink-300 transition hover:text-ink-50"
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <a
        href={altLangHref}
        class="rounded-md px-2 py-1 text-xs text-ink-400 transition hover:text-ink-100"
      >
        {t('nav.langSwitch')}
      </a>
      <BayjfLink size={18} class="hidden rounded-md px-2 py-1.5 text-xs text-ink-300 transition hover:text-ink-50 sm:inline-block" />
      <StarOnGithub href={SOCIAL.github} size={15} class="hidden text-ink-300 sm:inline-flex" />
      <a
        href={APP_URL}
        target="_blank"
        rel="noopener"
        class="rounded-md bg-brand-500 px-3 py-1.5 text-xs font-medium text-white transition hover:bg-brand-600"
      >
        {t('nav.openApp')}
      </a>
    </div>
  </nav>
</header>
