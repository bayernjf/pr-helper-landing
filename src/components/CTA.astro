---
import { useTranslations, localizePath, type Lang } from '../i18n';
import { SOCIAL, APP_URL } from '../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="border-t border-ink-800/60 bg-ink-950 py-20">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
    <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('cta.title')}</h2>
    <p class="mt-3 text-ink-400">{t('cta.subtitle')}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={APP_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex w-full items-center justify-center rounded-lg bg-brand-500 px-6 py-3 text-sm font-medium text-white transition hover:bg-brand-600 sm:w-auto"
      >
        {t('cta.app')}
      </a>
      <a
        href={localizePath('/#workflow', lang)}
        class="inline-flex w-full items-center justify-center rounded-lg border border-ink-700 px-6 py-3 text-sm font-medium text-ink-200 transition hover:border-ink-500 hover:text-white sm:w-auto"
      >
        {t('cta.button')}
      </a>
      <a
        href={`mailto:${SOCIAL.email}`}
        class="inline-flex w-full items-center justify-center px-6 py-3 text-sm font-medium text-ink-300 transition hover:text-white sm:w-auto"
      >
        {lang === 'zh' ? '联系我们' : 'Contact us'}
      </a>
    </div>
  </div>
</section>
