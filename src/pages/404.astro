---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { localizePath } from '../i18n';
---

<BaseLayout lang="en" title="404 | PR Helper" description="Page not found">
  <Nav lang="en" />
  <main class="mx-auto flex max-w-3xl flex-col items-center px-4 py-32 text-center sm:px-6">
    <span class="font-mono text-6xl font-bold text-brand-400">404</span>
    <h1 class="mt-4 text-2xl font-bold text-ink-50">Page not found</h1>
    <p class="mt-3 text-ink-400">The page you are looking for does not exist or has been moved.</p>
    <a
      href={localizePath('/', 'en')}
      class="mt-8 inline-flex items-center justify-center rounded-lg bg-brand-500 px-6 py-3 text-sm font-medium text-white transition hover:bg-brand-600"
    >
      Back to home
    </a>
  </main>
  <Footer lang="en" />
</BaseLayout>