---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SOCIAL } from '../consts';

const lang = 'en' as const;
const title = `Terms of Service | ${SITE_NAME}`;
const description = `Terms of Service of ${SITE_NAME}: the agreement covering use of this site and its content.`;
---

<BaseLayout lang={lang} title={title} description={description}>
  <Nav lang={lang} />
  <main class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold text-ink-50">Terms of Service</h1>
    <p class="mt-2 text-sm text-ink-500">Last updated: August 7, 2026</p>

    <div class="mt-8 space-y-8 text-sm leading-7 text-ink-300">
      <section>
        <h2 class="text-lg font-semibold text-ink-100">1. Acceptance</h2>
        <p class="mt-2">
          Welcome to {SITE_NAME} (the "Site"). By accessing or using the Site you agree to be bound by these terms. If you do not agree, please do not use the Site.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-100">2. Site Content</h2>
        <p class="mt-2">
          Content on the Site is provided "as is" for product introduction purposes and may change as the product evolves. We strive for accuracy but make no express or implied warranties regarding completeness or timeliness.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-100">3. Intellectual Property</h2>
        <p class="mt-2">
          The Site's copy, design, and branding belong to the project team and may not be used commercially without permission. Open-source code is governed by the license declared in its repository.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-100">4. Acceptable Use</h2>
        <p class="mt-2">
          Do not use the Site in ways that could harm or disrupt its operation or infringe on others' rights, including malicious scraping, injection attacks, or impersonation of the Site.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-100">5. Limitation of Liability</h2>
        <p class="mt-2">
          To the maximum extent permitted by law, the Site is not liable for any indirect, incidental, or consequential damages arising from use of or inability to use its content.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-100">6. Changes</h2>
        <p class="mt-2">
          These terms may be updated; changes will be posted on this page. Continued use of the Site constitutes acceptance of the updated terms.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-100">7. Contact</h2>
        <p class="mt-2">
          Questions can be raised via Issues on our
          <a href={SOCIAL.github} class="text-brand-400 hover:text-brand-300">GitHub repository</a>.
        </p>
      </section>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
