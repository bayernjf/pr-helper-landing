---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { localizePath } from '../../../i18n';

const lang = 'zh' as const;
const posts = (await getCollection('blog', (e) => e.data.lang === 'zh')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout lang={lang}>
  <Nav lang={lang} />
  <main class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold text-ink-50">博客</h1>
    <p class="mt-2 text-ink-400">发布工作流、架构解读与 Lane 实践深度内容</p>

    <ul class="mt-10 space-y-6">
      {posts.map((post) => {
        const slug = post.id.replace(/^zh\//, '');
        return (
          <li class="border-b border-ink-800/60 pb-6">
            <a href={localizePath(`/blog/${slug}`, lang)} class="group block">
              <h2 class="text-xl font-semibold text-ink-100 transition group-hover:text-brand-300">
                {post.data.title}
              </h2>
              <p class="mt-2 text-sm text-ink-400">{post.data.description}</p>
              <time class="mt-2 block text-xs text-ink-500" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </a>
          </li>
        );
      })}
    </ul>
  </main>
  <Footer lang={lang} />
</BaseLayout>
